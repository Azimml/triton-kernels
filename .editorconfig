# EditorConfig: consistent whitespace across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
# Matches ruff's formatter: 4-space indent, 100-column soft limit.
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Markdown can use trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
